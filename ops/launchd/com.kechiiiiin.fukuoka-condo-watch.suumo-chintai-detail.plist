<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  賃貸の詳細ページ（LDK の畳数・階・メゾネット・週 1 回）のテンプレート。直接コピーしない。ops/launchd/install.sh がリポジトリ・node・ホームのパスを埋めて
  ~/Library/LaunchAgents/ に置き、launchctl bootstrap する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.kechiiiiin.fukuoka-condo-watch.suumo-chintai-detail</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/launchd/run-suumo-detail.sh</string>
  </array>
  <key>WorkingDirectory</key> <string>__REPO__</string>

  <!-- LDK の畳数・部屋の階・階建・メゾネットを詳細ページから取る。**毎日 16:00**
       （2026-09-27 に週 1 回から変えた。1 回 60 件までなので、週 1 だと新着が溜まって
       画面に「LDK畳数 未取得」が並んだままになるため）。
       土曜は **1 周目（06:00）・ペット（12:00）・メゾネット（14:00）の後**になるよう 16:00 のまま
       （取りに行くのは「それらの条件を全部通った最終候補」なので、印が付く前に走らせても対象が出ない）。
       ⚠️ 未取得が無い日は SUUMO に 1 回もアクセスせず即終了する（取得済みは取り直さない）ので、毎日でも空振りは軽い。
       1 回 60 件まで × 61 秒 ≒ 1 時間。超えた分は翌日へ持ち越し。
       他の 4 本と同じロックファイルなので、重なったら終わるまで待つ。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>    <integer>16</integer>
    <key>Minute</key>  <integer>0</integer>
  </dict>
  <!-- 入れた瞬間には走らせない（初回は手動: launchctl kickstart） -->
  <key>RunAtLoad</key>        <false/>

  <!-- launchd は PATH を継承しないので、install.sh が解決した node を渡す -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key>       <string>__NODE_BIN__</string>
    <key>PATH</key>           <string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-chintai-detail.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-chintai-detail.err.log</string>

  <!-- ⚠️ トークンは絶対にここへ書かない（launchctl print / ps から丸見えになる）。
       ~/.config/fukuoka-condo-watch/env（chmod 600）からクローラ自身がファイルとして読む。 -->
</dict>
</plist>
