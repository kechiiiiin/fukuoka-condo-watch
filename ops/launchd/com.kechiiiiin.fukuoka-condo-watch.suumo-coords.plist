<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  掲載（中古・賃貸）の建物の座標（毎日 14 回）のテンプレート。直接コピーしない。ops/launchd/install.sh がリポジトリ・node・ホームのパスを埋めて
  ~/Library/LaunchAgents/ に置き、launchctl bootstrap する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.kechiiiiin.fukuoka-condo-watch.suumo-coords</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/launchd/run-suumo-coords.sh</string>
  </array>
  <key>WorkingDirectory</key> <string>__REPO__</string>

  <!-- 掲載の座標（「バスで職場・学校へ直通」の判定に使う）を詳細ページ（中古）・周辺環境ページ（賃貸）から取る。
       2026-11-01〜 run-suumo-coords.sh はその前に国土地理院の住所検索で番地のある住所に仮座標を入れる（scripts/gsi-coords.ts。
       1 秒間隔・未試行が無ければ即終了。失敗しても SUUMO は走る）。SUUMO は同じ建物を 1 件だけ・賃貸を先に取る。
       **毎日 09:00〜23:00 の毎正時（16:00 を除く 14 回）**（2026-11-01〜。それまでは 11:00 と 17:15 の 2 回）。
       一覧の周回（01:00〜≒08:15）の後から始め、16:00 は賃貸の詳細ページ（最大 ≒1 時間）に譲る。
       1 回 60 件まで × 61 秒 ≒ 1 時間（詳細ページの周回と同じ上限・間隔）なので、1 日 最大 840 件。超えた分は次回へ持ち越し。
       未取得が無い回は SUUMO に 1 回もアクセスせず即終了する（取得済みは取り直さない）。たまった数千件が埋まれば、新着の分だけになる。
       他の 6 本と同じロックファイルなので、重なったら終わるまで待つ（launchd は前の回が走っている間は次を重ねて起こさない）。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>    <integer>9</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>10</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>11</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>12</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>13</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>14</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>15</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>17</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>18</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>19</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>20</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>21</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>22</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>23</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
  </array>
  <!-- 入れた瞬間には走らせない（初回は手動: launchctl kickstart） -->
  <key>RunAtLoad</key>        <false/>

  <!-- launchd は PATH を継承しないので、install.sh が解決した node を渡す -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key>       <string>__NODE_BIN__</string>
    <key>PATH</key>           <string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-coords.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-coords.err.log</string>

  <!-- ⚠️ トークンは絶対にここへ書かない（launchctl print / ps から丸見えになる）。
       ~/.config/fukuoka-condo-watch/env（chmod 600）からクローラ自身がファイルとして読む。 -->
</dict>
</plist>
