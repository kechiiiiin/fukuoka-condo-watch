<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  掲載（中古・賃貸）の建物の座標（毎日 2 回）のテンプレート。直接コピーしない。ops/launchd/install.sh がリポジトリ・node・ホームのパスを埋めて
  ~/Library/LaunchAgents/ に置き、launchctl bootstrap する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.kechiiiiin.fukuoka-condo-watch.suumo-coords</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/launchd/run-suumo-coords.sh</string>
  </array>
  <key>WorkingDirectory</key> <string>__REPO__</string>

  <!-- 掲載の座標（「バスで職場・学校へ直通」の判定に使う）を詳細ページ（中古）・周辺環境ページ（賃貸）から取る。
       **毎日 11:00 と 17:15**（2026-10-31〜）。どちらも一覧の周回（01:00〜≒08:15）・新築（日曜 09:00・≒25 分）・
       賃貸の詳細ページ（16:00・最大 ≒1 時間）と重ならない時刻にしてある。
       1 回 60 件まで × 61 秒 ≒ 1 時間（詳細ページの周回と同じ上限・間隔）。超えた分は次回へ持ち越し。
       未取得が無い日は SUUMO に 1 回もアクセスせず即終了する（取得済みは取り直さない）。
       1 日 2 回にしているのは、最初は掲載中の数千件が全部未取得のため（条件に近いものから取るので、画面で要る分は先に埋まる）。
       他の 6 本と同じロックファイルなので、重なったら終わるまで待つ。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>    <integer>11</integer>
      <key>Minute</key>  <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>    <integer>17</integer>
      <key>Minute</key>  <integer>15</integer>
    </dict>
  </array>
  <!-- 入れた瞬間には走らせない（初回は手動: launchctl kickstart） -->
  <key>RunAtLoad</key>        <false/>

  <!-- launchd は PATH を継承しないので、install.sh が解決した node を渡す -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key>       <string>__NODE_BIN__</string>
    <key>PATH</key>           <string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-coords.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-coords.err.log</string>

  <!-- ⚠️ トークンは絶対にここへ書かない（launchctl print / ps から丸見えになる）。
       ~/.config/fukuoka-condo-watch/env（chmod 600）からクローラ自身がファイルとして読む。 -->
</dict>
</plist>
