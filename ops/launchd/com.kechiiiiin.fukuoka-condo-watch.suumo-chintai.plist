<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  賃貸（週 1 回）のテンプレート。直接コピーしない。ops/launchd/install.sh がリポジトリ・node・ホームのパスを埋めて
  ~/Library/LaunchAgents/ に置き、launchctl bootstrap する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.kechiiiiin.fukuoka-condo-watch.suumo-chintai</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/launchd/run-suumo-crawl.sh</string>
    <string>--kind</string>
    <string>chintai</string>
  </array>
  <key>WorkingDirectory</key> <string>__REPO__</string>

  <!-- 賃貸（/chintai/）を毎週土曜 06:00（Mac のタイムゾーン = JST）。中古の日次（01:00〜≒05:00）とも
       新築（日曜 06:00）とも重ならない時刻。取得時に絞り込む（src/suumo-chintai.ts の CHINTAI_QUERY）ので
       1 回 ≒ 数十〜200 ページ × 61 秒。中古・新築と同じロックファイルを使うので、重なったら終わるまで待つ。
       スリープしていた間に過ぎたら、起きたあと 1 回だけ走る。取れなかった週は翌週（カーソルは日付ごとの回）。 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key> <integer>6</integer>
    <key>Hour</key>    <integer>6</integer>
    <key>Minute</key>  <integer>0</integer>
  </dict>
  <!-- 入れた瞬間には走らせない（初回は手動: launchctl kickstart） -->
  <key>RunAtLoad</key>        <false/>

  <!-- launchd は PATH を継承しないので、install.sh が解決した node を渡す -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_BIN</key>       <string>__NODE_BIN__</string>
    <key>PATH</key>           <string>__PATH__</string>
  </dict>

  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-chintai-crawl.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/fukuoka-condo-watch/suumo-chintai-crawl.err.log</string>

  <!-- ⚠️ トークンは絶対にここへ書かない（launchctl print / ps から丸見えになる）。
       ~/.config/fukuoka-condo-watch/env（chmod 600）からクローラ自身がファイルとして読む。 -->
</dict>
</plist>
