{
  "name": "fukuoka-condo-watch",
  "version": "1.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "fake-suumo": "tsx scripts/fake-suumo-server.ts",
    "crawl:local": "tsx scripts/suumo-crawl-local.ts",
    "access-app": "tsx scripts/access-app.ts",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fukuoka-condo-watch --local",
    "db:migrate:remote": "wrangler d1 migrations apply fukuoka-condo-watch --remote",
    "backfill": "tsx scripts/backfill.ts",
    "load-geo": "tsx scripts/load-geo.ts",
    "estat": "tsx scripts/estat.ts"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "private": "true"
}
